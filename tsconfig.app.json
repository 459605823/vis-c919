{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/**/*", "src/**/*.vue", "src/**/*.json",],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "types": [
      "vite/client",
      "unplugin-vue-router/client"
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
